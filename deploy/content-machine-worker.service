[Unit]
Description=Content Machine worker (radar, voice, render, upload)
After=network-online.target
Wants=network-online.target

[Service]
User=machine
Group=machine
WorkingDirectory=/opt/content-machine
EnvironmentFile=/etc/content-machine.env
ExecStart=/opt/content-machine/.venv/bin/python -m machine worker
Restart=always
RestartSec=10
Nice=10
# keep rendering gentle: never more than ~2 of the server's cores, never all the RAM
CPUWeight=50
CPUQuota=200%
MemoryMax=5G

[Install]
WantedBy=multi-user.target
